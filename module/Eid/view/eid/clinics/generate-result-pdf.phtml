<?php

// The page layout lives in application/common/result-pdf.phtml, shared with
// the VL result PDF. This view only says which EID fields go on the page.

$approval = function (array $result): string {
     $approvedBy = ucwords(trim((string) ($result['approvedBy'] ?? '')));
     if ($approvedBy === '') {
          return '';
     }
     $approvedAt = trim((string) ($result['result_approved_datetime'] ?? ''));
     if ($approvedAt === '' || in_array($approvedAt, ['0000-00-00 00:00:00', '1970-01-01 00:00:00'], true)) {
          return $approvedBy . '  ';
     }
     [$date, $time] = array_pad(explode(' ', $approvedAt, 2), 2, '');

     return $approvedBy . ' ' . $this->humanReadableDateFormat($date) . ' ' . $time;
};

echo $this->partial('application/common/result-pdf.phtml', [
     'sampleResult' => $sampleResult,
     'config' => $config,
     'test' => 'eid',
     'describe' => fn(array $result) => [
          'patientName' => ucwords(trim((string) ($result['child_name'] ?? ''))) . ' ' . ucwords(trim((string) ($result['child_surname'] ?? ''))),
          'referredBy' => $result['requestCreated'] ?? '',
          'rows' => [
               ['Reason for Application', '...................', $result['test_reason_name'] ?? ''],
               null,
               null,
          ],
          'authorizedBy' => $approval($result),
     ],
]);
