<?php

// The page layout lives in application/common/result-pdf.phtml, shared with
// the EID result PDF. This view only says which VL fields go on the page.

$name = fn(array $result, string $key) => ucwords(trim((string) ($result[$key] ?? '')));
$approval = function (array $result): string {
     if (empty($result['result_approved_by'])) {
          return '';
     }
     $approvedAt = empty($result['result_approved_datetime']) ? '' : $this->humanReadableDateFormat($result['result_approved_datetime']);

     return $result['result_approved_by'] . ' ' . $approvedAt;
};

echo $this->partial('application/common/result-pdf.phtml', [
     'sampleResult' => $sampleResult,
     'config' => $config,
     'test' => 'vl',
     'describe' => fn(array $result) => [
          'patientName' => $name($result, 'patient_first_name') . ' ' . $name($result, 'patient_last_name'),
          'referredBy' => $result['request_clinician_name'] ?? '',
          'rows' => [
               ['Date of ART Regimen', '...................', $result['date_of_initiation_of_current_regimen'] ?? ''],
               ['Reason for Application', '...................', $result['reason_for_vl_testing'] ?? ''],
               ['ART Regimen', '................................', $result['current_regimen'] ?? ''],
               null,
               ['Viral Load (CAP/CTM)', '...................', ($result['result'] ?? '') . ' (' . $this->translate("copies/ml") . ')'],
               ['Log Value', '.....................................', $result['result_value_log'] ?? ''],
               null,
          ],
          'authorizedBy' => $approval($result),
     ],
]);
