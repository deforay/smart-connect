<?php

/**
 * Writes one result page per sample, joins the pages into one PDF in
 * EXPORT_PATH and echoes its file name for /download/.
 *
 * Shared by the VL and EID result views, which pass:
 *
 * @var array    $sampleResult  rows from getSampleInfo()
 * @var array    $config        global config, for the logo
 * @var string   $test          'vl' or 'eid', see $labels below
 * @var callable $describe      fn(array $result): array with
 *                              patientName, referredBy, authorizedBy (text
 *                              after "Authorized By", or ''), and rows: a
 *                              list of [label, dots, value], or null for a
 *                              blank line
 */

use Application\Pdf\PdfConcat;
use Application\Pdf\ResultPage;
use Application\Service\CommonService;

$labels = [
     'vl' => ['footer' => 'Report generated by Viral Load Dashboard', 'heading' => 'HIV Viral Load', 'file' => 'Viral-Load-Result'],
     'eid' => ['footer' => 'Report generated by EID Dashboard', 'heading' => 'EID', 'file' => 'EID-Result'],
][$test];

$cell = 'style="font-size:11px;"';
$row = fn(string $left, string $right) => '<tr><td ' . $cell . '>' . $left . '</td><td ' . $cell . '></td><td ' . $cell . '>' . $right . '</td></tr>';
$labelled = fn(string $label, $value) => '<strong>' . $this->translate($label) . '</strong> : ' . $value;
$dateOr = fn($date) => empty($date) ? 'Not Reported' : $this->humanReadableDateFormat($date);

$logo = APPLICATION_PATH . DIRECTORY_SEPARATOR . 'assets' . DIRECTORY_SEPARATOR . 'img' . DIRECTORY_SEPARATOR . 'default-logo.png';
if (isset($config['logo']) && trim($config['logo']) != "" && file_exists(UPLOAD_PATH . DIRECTORY_SEPARATOR . "logo" . DIRECTORY_SEPARATOR . $config['logo'])) {
     $logo = APPLICATION_PATH . DIRECTORY_SEPARATOR . 'uploads' . DIRECTORY_SEPARATOR . 'logo' . DIRECTORY_SEPARATOR . $config['logo'];
}

$pages = [];
foreach ($sampleResult as $result) {
     $details = $describe($result);

     $pdf = new ResultPage(PDF_PAGE_ORIENTATION, PDF_UNIT, PDF_PAGE_FORMAT, true, 'UTF-8', false);
     $pdf->setBranding($logo, $result['labName'] ?? '', $labels['footer']);
     $pdf->SetCreator(PDF_CREATOR);
     $pdf->SetAuthor('VL Dashboard');
     $pdf->SetTitle('Viral Load Result');
     $pdf->SetHeaderData(PDF_HEADER_LOGO, PDF_HEADER_LOGO_WIDTH, PDF_HEADER_TITLE, PDF_HEADER_STRING);
     $pdf->setHeaderFont([PDF_FONT_NAME_MAIN, '', PDF_FONT_SIZE_MAIN]);
     $pdf->setFooterFont([PDF_FONT_NAME_DATA, '', PDF_FONT_SIZE_DATA]);
     $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);
     $pdf->SetAutoPageBreak(true, PDF_MARGIN_BOTTOM);
     $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);
     $pdf->SetFont('helvetica', '', 10);
     $pdf->AddPage();
     $pdf->SetY(40, true, false);

     $html = '<table style="padding:0px 2px 2px 2px;">';
     $html .= '<tr><td></td><td style="font-weight:bold;text-align:center;">' . $this->translate("Laboratory Result") . '</td><td></td></tr>';
     $html .= $row($details['patientName'], $labelled("Collected", $dateOr($result['sample_collection_date'] ?? '')));
     $html .= $row($result['labName'] ?? '', $labelled("Sample ID", $result['sample_code']));
     $html .= $row('', '');
     $html .= $row($labelled("Referred by", $details['referredBy']), $labelled("Specimen", ucwords($result['sample_name'] ?? '')));
     $html .= $row(($result['provinceName'] ?? '') . ' | ' . ($result['districtName'] ?? ''), $labelled("Issued", $dateOr($result['sample_tested_datetime'] ?? '')));
     $html .= '<tr><td colspan="3" style="line-height:11px;font-size:11px;text-align:left;"></td></tr>';
     $html .= '<tr><td colspan="3" style="line-height:21px;font-size:11px;font-weight:bold;text-align:left;">' . $this->translate($labels['heading']) . '</td></tr>';
     foreach ($details['rows'] as $testRow) {
          if ($testRow === null) {
               $html .= '<tr><td colspan="3" style="line-height:10px;"></td></tr>';
               continue;
          }
          [$label, $dots, $value] = $testRow;
          $html .= '<tr><td colspan="3" style="text-indent:10px;line-height:18px;font-size:11px;text-align:left;letter-spacing:1px;">' . $this->translate($label) . ' ' . $dots . ' ' . $value . '</td></tr>';
     }
     if ($details['authorizedBy'] !== '') {
          $html .= '<tr><td colspan="3" ' . $cell . '>' . $this->translate("Authorized By") . ' ' . $details['authorizedBy'] . '</td></tr>';
     }
     $html .= '<tr><td colspan="3" style="line-height:18px;font-size:11px;text-align:center;letter-spacing:1px;"><br><br>.... ' . $this->translate("End of report") . ' ....</td></tr>';
     $html .= '</table>';

     $pdf->writeHTML($html);
     $pdf->lastPage();
     $pageFile = EXPORT_PATH . DIRECTORY_SEPARATOR . CommonService::exportFileName('result-page', 'pdf');
     $pdf->Output($pageFile, "F");
     $pages[] = $pageFile;
}

$resultFilename = '';
if (!empty($pages)) {
     $resultPdf = new PdfConcat();
     $resultPdf->setPrintHeader(false);
     $resultPdf->setPrintFooter(false);
     $resultPdf->concat($pages);
     $resultFilename = CommonService::exportFileName($labels['file'] . '-' . $result['sample_code'], 'pdf');
     $resultPdf->Output(EXPORT_PATH . DIRECTORY_SEPARATOR . $resultFilename, "F");
     foreach ($pages as $pageFile) {
          unlink($pageFile);
     }
}
echo $resultFilename;
