<?php

use Application\View\TatReport;

// The EID TAT views render this template with drillUrl set to their own page.
$drillUrl = $drillUrl ?? '/times/dashboard';
$total = $this->translate('Total');
$headings = [$this->translate('Places'), $this->translate('Collect-Receive'), $this->translate('Receive-Analysis'), $this->translate('Analysis-Authorise'), $total];
$stageNames = array_slice($headings, 1, 3);
$chartLabels = ['tatInDays' => $this->translate('TAT in days'), 'total' => $total];
// Province and district bars drill down. Clinic bars do not.
$levels = [
  ['rows' => $resultProvinces ?? [], 'table' => 'provinceTable', 'chart' => 'provinceChart', 'category' => 0, 'param' => 'province', 'title' => 'TAT by Province', 'chartTitle' => 'Provinces Chart', 'rowChartTitle' => 'Provinces Chart'],
  ['rows' => $resultDistricts ?? [], 'table' => 'districtTable', 'chart' => 'districtChart', 'category' => 1, 'param' => 'district', 'title' => 'TAT by District', 'chartTitle' => 'Districts chart', 'rowChartTitle' => 'Districts Chart'],
  ['rows' => $resultClinics ?? [], 'table' => 'clinicTable', 'chart' => 'clinicChart', 'category' => 2, 'param' => null, 'title' => 'TAT by Clinic', 'chartTitle' => 'Clinics chart', 'rowChartTitle' => 'Clinics Chart'],
];
?>
<script type="text/javascript">
  $(function() {
    var drillUrl = <?= TatReport::js($drillUrl) ?>;
    var labs = <?= TatReport::js($labs) ?>;
    var range = <?= TatReport::js($daterange) ?>;
    var html = '<div class="">';
    <?php foreach ($levels as $level) { if (!empty($level['rows'])) { ?>
    html += getRow(<?= TatReport::tableJs($level['rows'], $level['table'], $level['category'], $labs, $daterange, $level['param'] !== null, $headings) ?>, '<?= $level['table'] ?>', '<?= $level['chart'] ?>', <?= TatReport::js($this->translate($level['title'])) ?>, <?= TatReport::js($this->translate($level['rowChartTitle'])) ?>);
    <?php } } ?>
    $('#page-data-viewer').html(html + '</div>');
    <?php foreach ($levels as $level) { ?>
    drawTATChart('<?= $level['table'] ?>', '<?= $level['chart'] ?>', '<?= $level['chartTitle'] ?>', <?= TatReport::seriesJs($level['rows'], $stageNames) ?>, <?= TatReport::js($chartLabels) ?>, <?php if ($level['param'] !== null) { ?>function() {
      window.location.href = drillUrl + '?<?= $level['param'] ?>=' + this.id + '&lab=' + labs + '&range=' + range + '&category=<?= $level['category'] ?>&place=' + this.category;
    }<?php } else { ?>null<?php } ?>);
    <?php } ?>

    $('.clickable').click(function() {
      if ($(this).attr('data-category') != 2) {
        window.location.href = drillUrl + '?district=' + $(this).attr('id') + '&lab=' + labs + '&range=' + range + '&category=' + $(this).attr('data-category') + '&place=' + $(this).attr('data-place');
      }
    });
  });
</script>
