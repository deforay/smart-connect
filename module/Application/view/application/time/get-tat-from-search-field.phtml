<?php
// The EID TAT views render this template with drillUrl set to their own page.
$drillUrl = $drillUrl ?? '/times/dashboard';
$cont = 0;
$tableHeader = '';
$tableBody = '';
$tableFooter = '';
$categoryNext = 0;
$places = $this->translate('Places');
$collectReceive = $this->translate('Collect-Receive');
$receiveAnalysis = $this->translate('Receive-Analysis');
$analysisAuthorise = $this->translate('Analysis-Authorise');
$total = $this->translate('Total');
?>
<script type="text/javascript">
  $(function() {
    $('#page-data-viewer').html(
      '<div class="">' +
      <?php
      if (!empty($resultProvinces)) {  ?> getRow(<?php ob_start(); generateTable($resultProvinces, 'provinceTable', 0, $labs, $daterange, $places, $collectReceive, $receiveAnalysis, $analysisAuthorise, $total); echo json_encode(ob_get_clean(), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP); ?>, 'provinceTable', 'provinceChart', '<?php echo $this->translate('TAT by Province'); ?>', '<?php echo $this->translate('Provinces Chart'); ?>') +
      <?php
      }
      if (!empty($resultDistricts)) {  ?> getRow(<?php ob_start(); generateTable($resultDistricts, 'districtTable', 1, $labs, $daterange, $places, $collectReceive, $receiveAnalysis, $analysisAuthorise, $total); echo json_encode(ob_get_clean(), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP); ?>, 'districtTable', 'districtChart', '<?php echo $this->translate('TAT by District'); ?>', '<?php echo $this->translate('Districts Chart'); ?>') +
      <?php
      }
      if (!empty($resultClinics)) {   ?> getRow(<?php ob_start(); generateTable($resultClinics, 'clinicTable', 2, $labs, $daterange, $places, $collectReceive, $receiveAnalysis, $analysisAuthorise, $total); echo json_encode(ob_get_clean(), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP); ?>, 'clinicTable', 'clinicChart', '<?php echo $this->translate('TAT by Clinic'); ?>', '<?php echo $this->translate('Clinics Chart'); ?>') +
      <?php
      }
      ?> '</div>'
    );
    generateChart('provinceTable', 'provinceChart', 'Provinces Chart', <?php getSeries($resultProvinces, $collectReceive, $receiveAnalysis, $analysisAuthorise) ?>, 'PROVINCES');
    generateChart('districtTable', 'districtChart', 'Districts chart', <?php getSeries($resultDistricts, $collectReceive, $receiveAnalysis, $analysisAuthorise) ?>, 'DISTRICTS');
    <?php if (!empty($resultClinics) || !is_null($resultClinics)) { ?>
      generateChart('clinicTable', 'clinicChart', 'Clinics chart', <?php getSeries($resultClinics, $collectReceive, $receiveAnalysis, $analysisAuthorise) ?>, 'CLINICS');
    <?php } ?>

    $('.clickable').click(function() {
      if ($(this).attr('data-category') != 2) {
        window.location.href = '<?php echo $drillUrl; ?>?district=' + $(this).attr('id') + '&lab=<?php echo $labs; ?>&range=<?php echo $daterange; ?>&category=' + $(this).attr('data-category') + '&place=' + $(this).attr('data-place');
      }
    });
  });

  function generateChart(idTable, idChart, chartTitle, series, category) {
    var tatTotals = getTATChartTotals(idTable);
    $('#' + idChart).highcharts({
      chart: {
        type: 'column'
      },
      title: {
        text: ''
      },
      exporting: {
        chartOptions: {
          subtitle: {
            text: chartTitle,
          }
        },
        width: 2000
      },
      credits: {
        enabled: false
      },
      xAxis: {
        categories: getTATChartData(idTable)
      },
      yAxis: {
        min: 0,
        title: {
          text: '<?php echo $this->translate('TAT in days'); ?>'
        },
        stackLabels: {
          enabled: true,
          formatter: function() {
            return tatTotals[this.x];
          },
          style: {
            fontWeight: 'bold',
            color: (Highcharts.theme && Highcharts.theme.textColor) || 'gray'
          }
        }
      },
      legend: {
        align: 'center',
        x: 0,
        verticalAlign: 'top',
        y: 0,
        floating: true,
        backgroundColor: (Highcharts.theme && Highcharts.theme.background2) || 'white',
        borderColor: '#CCC',
        borderWidth: 1,
        shadow: false
      },
      tooltip: {
        headerFormat: '<b>{point.x}</b><br/>',
        pointFormatter: function() {
                return this.series.name + ': ' + this.y + '<br/><?php echo $this->translate('Total'); ?>: ' + tatTotals[this.index];
              }
      },
      plotOptions: {
        column: {
          stacking: 'normal',
          dataLabels: {
            enabled: true,
            color: (Highcharts.theme && Highcharts.theme.dataLabelsColor) || 'white'
          },
          cursor: (category == 'PROVINCES' || category == 'DISTRICTS') ? 'pointer' : 'default',
          point: {
            events: {
              <?php
              if ($categoryNext == 0 || $categoryNext == 1) {
              ?>
                click: function() {
                  if (category == 'PROVINCES') {
                    window.location.href = '<?php echo $drillUrl; ?>?province=' + this.id + '&lab=<?php echo $labs; ?>&range=<?php echo $daterange; ?>&category=0&place=' + this.category;
                  } else if (category == 'DISTRICTS') {
                    window.location.href = '<?php echo $drillUrl; ?>?district=' + this.id + '&lab=<?php echo $labs; ?>&range=<?php echo $daterange; ?>&category=1&place=' + this.category;
                  }
                }
              <?php
              }
              ?>
            }
          }
        }
      },
      series: series
    });
  }
</script>

<?php
function getSeries($results, $collectReceive, $receiveAnalysis, $analysisAuthorise)
{
  echo "[
      {
          name: '$collectReceive',
          data:[";
  foreach ($results as $key) {
    echo "          {
                    y: ";
    if (!is_null($key['collect_receive'])) {
      echo $key['collect_receive'];
    } else {
      echo 0;
    }
    echo ",
                    id: '";
    if (!is_null($key['facility_id'])) {
      echo $key['facility_id'];
    } else {
      echo 0;
    }
    echo "'
                  },";
  }
  echo "
             ]
      },
      {
          name: '$receiveAnalysis',
          data:[";
  foreach ($results as $key) {
    echo "{
                    y: ";
    if (!is_null($key['receive_analysis'])) {
      echo $key['receive_analysis'];
    } else {
      echo 0;
    }
    echo ",
                    id: '";
    if (!is_null($key['facility_id'])) {
      echo $key['facility_id'];
    } else {
      echo 0;
    }
    echo "'
                  },";
  }
  echo "
             ]
      },
      {
          name: '$analysisAuthorise',
          data:[";
  foreach ($results as $key) {
    echo "  {
                    y: ";
    if (!is_null($key['analysis_authorise'])) {
      echo $key['analysis_authorise'];
    } else {
      echo 0;
    }
    echo ",
                    id: '";
    if (!is_null($key['facility_id'])) {
      echo $key['facility_id'];
    } else {
      echo 0;
    }
    echo "'
                  },
              ";
  }
  echo "
             ]
      }
    ] ";
}

function generateTable($result, $idTable, $facilityCategory, $labs, $daterange, $places, $collectReceive, $receiveAnalysis, $analysisAuthorise, $total)
{
  $cont = 0;
  $tableHeader = '';
  $tableBody = '';
  $tableFooter = '';
  $category = '';
  $categoryNext = 0;
  $clickable = ($idTable == "clinicTable") ? '' : 'clickable';
  $tableHeader = '<table class="' . $idTable . ' header">'
    . '<thead>'
    . '<th>' . $places . '</th>'
    . '<th>' . $collectReceive . '</th>'
    .'<th>' . $receiveAnalysis . '</th>'
    . '<th>' . $analysisAuthorise . '</th>'
    . '<th>' . $total . '</th>'
    . '</thead>'
    . '</table>';
  foreach ($result as $key) {
    $tableBody .= '<tr class="' . $clickable . '" id="' . $key['facility_id'] . '" data-labs="' . $labs . '" data-date-range="' . $daterange . '" data-category="' . $facilityCategory . '"  data-place="' . htmlspecialchars((string) $key['facility'], ENT_QUOTES, 'UTF-8') . '">'
      . '<td id="td-' . $cont . '-0">' . htmlspecialchars((string) $key['facility'], ENT_QUOTES, 'UTF-8') . '</td>'
      . '<td id="td-' . $cont . '-1">' . $key['collect_receive'] . '</td>'
      . '<td id="td-' . $cont . '-2">' . $key['receive_analysis'] . '</td>'
      . '<td id="td-' . $cont . '-3">' . $key['analysis_authorise'] . '</td>'
      . '<td id="td-' . $cont . '-4">' . $key['total'] . '</td>'
      . '</tr>';
    $cont++;
    $category = $key['category'];
  }
  echo '<div class="scrolltable">'
    . $tableHeader
    . '<div class="body scrollbar style-3">'
    . '<table id="' . $idTable . '">'
    . '<tbody>'
    . $tableBody
    . '</tbody>'
    . '</table>'
    . '</div>'
    . '</div>';
}
?>