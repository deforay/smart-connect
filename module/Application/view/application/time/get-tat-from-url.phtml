function generateTable($result,$idTable,$facilityCategory,$labs,$daterange,$categoryVal,$places,$collectReceive,$receiveAnalysis,$analysisAuthorise,$total){
  $cont = 0;
  $tableHeader = '';
  $tableBody = '';
  $tableFooter = '';
//  $category = '';
  $categoryNext = 0;
  $clickable = ($categoryVal == 1)?'':'clickable';
  $tableHeader = '<table class="'.$idTable.' header">'
                    .'<thead>'
                        .'<th>'.$places.'</th>'
                        .'<th>'.$collectReceive.'</th>'
                        .'<th>'.$receiveAnalysis.'</th>'
                        .'<th>'.$analysisAuthorise.'</th>'
                        .'<th>'.$total.'</th>'
                    .'</thead>'
                  .'</table>';

  foreach ($result as $key) {
    $tableBody .= '<tr class="'.$clickable.'" id="'.$key['facility_id'].'" data-labs="'.$labs.'" data-date-range="'.$daterange.'" data-category="'.$facilityCategory.'" data-place="'.htmlspecialchars((string) $key['facility'], ENT_QUOTES, 'UTF-8').'">'
                    .'<td id="td-'.$cont.'-0">'.htmlspecialchars((string) $key['facility'], ENT_QUOTES, 'UTF-8').'</td>'
                    .'<td id="td-'.$cont.'-1">'.$key['collect_receive'].'</td>'
                    .'<td id="td-'.$cont.'-2">'.$key['receive_analysis'].'</td>'
                    .'<td id="td-'.$cont.'-3">'.$key['analysis_authorise'].'</td>'
                    .'<td id="td-'.$cont.'-4">'.$key['total'].'</td>'
                  .'</tr>';
    $cont ++;
    $category = $key['category'];
  }
  echo '<div class="scrolltable">'
          .$tableHeader
          .'<div class="body scrollbar style-3">'
              .'<table id="'.$idTable.'">'
                .'<tbody>'
                  .$tableBody
                .'</tbody>'
              .'</table>'
          .'</div>'
       .'</div>';
}
