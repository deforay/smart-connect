<?php

use Application\View\TatReport;

// The EID TAT views render this template with drillUrl set to their own page.
$drillUrl = $drillUrl ?? '/times/dashboard';
$total = $this->translate('Total');
$headings = [$this->translate('Places'), $this->translate('Collect-Receive'), $this->translate('Receive-Analysis'), $this->translate('Analysis-Authorise'), $total];
$stageNames = array_slice($headings, 1, 3);
$chartLabels = ['tatInDays' => $this->translate('TAT in days'), 'total' => $total];
?>
<script>
  $(function() {
    var drillUrl = <?= TatReport::js($drillUrl) ?>;
    var labs = <?= TatReport::js($labs) ?>;
    var range = <?= TatReport::js($daterange) ?>;
    $('#page-data-viewer').html(
      '<div class="">' +
      getRow(<?= TatReport::tableJs($results ?? [], 'provinceTable', 0, $labs, $daterange, true, $headings) ?>, 'provinceTable', 'provinceChart', <?= TatReport::js($this->translate('TAT by Province')) ?>, <?= TatReport::js($this->translate('Provinces Chart')) ?>) +
      '</div>'
    );
    drawTATChart('provinceTable', 'provinceChart', 'Provinces Chart', <?= TatReport::seriesJs($results ?? [], $stageNames) ?>, <?= TatReport::js($chartLabels) ?>, function() {
      window.location.href = drillUrl + '?province=' + this.id + '&lab=' + labs + '&range=' + range + '&category=0&place=' + this.category;
    });
    $('.clickable').click(function() {
      if ($(this).attr('data-category') != 2) {
        window.location.href = drillUrl + '?province=' + $(this).attr('id') + '&lab=' + $(this).attr('data-labs') + '&range=' + $(this).attr('data-date-range') + '&category=' + $(this).attr('data-category') + '&place=' + $(this).attr('data-place');
      }
    });
  });
</script>
