#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Write sys/schema/init.sql, the schema bin/setup.sh imports on a new server.
 *
 * Reads the structure from this checkout's database and the few tables it
 * lacks from the InteLIS (vlsm) database on the same MySQL server. smart-connect
 * mirrors those tables from vlsm. Seeds only the access-control and
 * configuration rows that the application needs before its first login.
 * Testing records, facilities and reference lists are left out, because each
 * LIS sends them when it syncs.
 *
 * The output is safe to import into an empty database only. It uses
 * CREATE TABLE IF NOT EXISTS and never drops anything. Every table uses
 * utf8mb4_general_ci, so it imports on MariaDB as well as MySQL 8.
 *
 * Usage:
 *   php bin/dev/export-schema [--vlsm-db=vlsm]
 */

chdir(dirname(__DIR__, 2));
require 'vendor/autoload.php';

use App\Version;
use Laminas\Db\Adapter\Adapter;
use Laminas\Mvc\Service\ServiceManagerConfig;
use Laminas\ServiceManager\ServiceManager;

// Tables retired with the Covid-19 module. The metadata sync accepts and
// discards their rows, so a new install does not need them.
const SKIP_TABLES = '/covid19/';

// Tables the code reads or writes that the dashboard database may lack.
// Their structure comes from vlsm, which smart-connect mirrors.
const FROM_VLSM = [
    'batch_details',
    'facility_type',
    'province_details',
    'r_hepatitis_results',
    'r_hepatitis_risk_factors',
    'r_hepatitis_sample_rejection_reasons',
    'r_hepatitis_sample_type',
    'r_hepatitis_test_reasons',
    'r_eid_test_reasons',
    'temp_mail',
    'user_details',
];

// Fixed lists that no LIS metadata sync fills. Their rows come from vlsm.
const ROWS_FROM_VLSM = [
    'facility_type',
    'r_sample_status',
];

// data/alter.sql inserted Clinician and Testing Lab Manager with a NULL role_id.
// role_id is not AUTO_INCREMENT and the app runs with an empty sql_mode, so both
// were stored as 0 and share each other's privileges. A new install gives each
// its own id, with the dashboards alter.sql meant each to reach.
const SPLIT_ROLES = [
    8 => ['Clinician', 'cli', [
        'Application\\Controller\\SummaryController', 'Eid\\Controller\\SummaryController',
        'Application\\Controller\\ClinicController', 'Eid\\Controller\\ClinicsController',
        'Application\\Controller\\SnapshotController',
    ]],
    9 => ['Testing Lab Manager', 'tlm', [
        'Application\\Controller\\SummaryController', 'Eid\\Controller\\SummaryController',
        'Application\\Controller\\LaboratoryController', 'Eid\\Controller\\LabsController',
        'Application\\Controller\\SnapshotController',
    ]],
];

// Rows a new install needs before anyone can log in.
const SEED_TABLES = [
    'dash_locale_details',
    'dash_privileges',
    'dash_resources',
    'dash_roles_privileges_map',
    'dash_user_roles',
];

// dash_global_config rows, with the values a new install starts from. Logos
// and messages belong to one country, so they start empty.
const GLOBAL_CONFIG_RESET = [
    'announcement_msg' => '',
    'language' => '1',
    'left_top_logo' => '',
    'logo' => '',
    'watermark_text' => '',
];

$vlsmDb = 'vlsm';
foreach (array_slice($argv, 1) as $arg) {
    if (str_starts_with($arg, '--vlsm-db=')) {
        $vlsmDb = substr($arg, strlen('--vlsm-db='));
    } else {
        fwrite(STDERR, "Unknown argument: {$arg}\n");
        exit(2);
    }
}

$appConfig = require 'config/application.config.php';
$serviceManager = new ServiceManager();
(new ServiceManagerConfig($appConfig['service_manager'] ?? []))->configureServiceManager($serviceManager);
$serviceManager->setService('ApplicationConfig', $appConfig);
$serviceManager->get('ModuleManager')->loadModules();

/** @var Adapter $adapter */
$adapter = $serviceManager->get(Adapter::class);
/** @var PDO $pdo */
$pdo = $adapter->getDriver()->getConnection()->getResource();
$pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

$version = trim((string) $pdo->query("SELECT `value` FROM dash_global_config WHERE `name` = 'db_version'")->fetchColumn());
if ($version !== Version::app()) {
    fwrite(STDERR, "The database is at schema version {$version}, but the code is at " . Version::app() . ". Run php bin/migrate first.\n");
    exit(1);
}

$tables = array_values(array_filter(
    $pdo->query('SHOW FULL TABLES WHERE Table_type = \'BASE TABLE\'')->fetchAll(PDO::FETCH_COLUMN),
    static fn(string $t): bool => !preg_match(SKIP_TABLES, $t)
));
sort($tables);

$out = [];
$out[] = '-- smart-connect schema ' . $version . '. Generated by bin/dev/export-schema. Do not edit by hand.';
$out[] = '-- Import into an empty database only, then run php bin/migrate.';
$out[] = '';
$out[] = 'SET NAMES utf8mb4;';
$out[] = 'SET FOREIGN_KEY_CHECKS = 0;';
$out[] = '';

$created = [];
foreach ($tables as $table) {
    $out[] = createStatement($pdo, $table) . ';';
    $out[] = '';
    $created[$table] = true;
}

foreach (FROM_VLSM as $table) {
    if (isset($created[$table])) {
        continue;
    }
    $out[] = '-- From ' . $vlsmDb . '.' . $table . '.';
    $out[] = createStatement($pdo, $table, $vlsmDb) . ';';
    $out[] = '';
}

// Privileges on retired modules' controllers, which no route reaches any more.
$retiredPrivileges = $pdo->query(
    "SELECT privilege_id FROM dash_privileges WHERE resource_id LIKE 'Covid19%'"
)->fetchAll(PDO::FETCH_COLUMN);

foreach (SEED_TABLES as $table) {
    // DISTINCT, because a table without a primary key can hold repeated rows.
    $rows = $pdo->query("SELECT DISTINCT * FROM `{$table}`")->fetchAll(PDO::FETCH_ASSOC);
    $rows = array_values(array_filter($rows, static fn(array $row): bool =>
        !str_starts_with((string) ($row['resource_id'] ?? ''), 'Covid19')
        && !in_array($row['privilege_id'] ?? null, $retiredPrivileges, false)
        // Role 0 is the pair alter.sql merged. Roles 8 and 9 are written below, so
        // a database built from this file exports them once, not twice.
        && !in_array((string) ($row['role_id'] ?? ''), array_merge(['0'], array_map('strval', array_keys(SPLIT_ROLES))), true)));
    $out = array_merge($out, insertStatements($pdo, $table, $rows));
}

foreach (SPLIT_ROLES as $roleId => [$name, $code, $resources]) {
    $out[] = "INSERT INTO `dash_user_roles` (`role_id`, `role_name`, `role_code`, `status`) VALUES ({$roleId}, " . $pdo->quote($name) . ', ' . $pdo->quote($code) . ", 'active');";
    $out[] = "INSERT INTO `dash_roles_privileges_map` (`role_id`, `privilege_id`) SELECT {$roleId}, `privilege_id` FROM `dash_privileges` WHERE `resource_id` IN (" . implode(', ', array_map([$pdo, 'quote'], $resources)) . ');';
}
$out[] = '';

foreach (ROWS_FROM_VLSM as $table) {
    $rows = $pdo->query("SELECT * FROM `{$vlsmDb}`.`{$table}`")->fetchAll(PDO::FETCH_ASSOC);
    $out = array_merge($out, insertStatements($pdo, $table, $rows));
}

$rows = $pdo->query('SELECT * FROM dash_global_config ORDER BY `name`')->fetchAll(PDO::FETCH_ASSOC);
foreach ($rows as &$row) {
    if (array_key_exists($row['name'], GLOBAL_CONFIG_RESET)) {
        $row['value'] = GLOBAL_CONFIG_RESET[$row['name']];
    }
}
unset($row);
$out = array_merge($out, insertStatements($pdo, 'dash_global_config', $rows));

$out[] = 'SET FOREIGN_KEY_CHECKS = 1;';

if (!is_dir('sys/schema')) {
    mkdir('sys/schema', 0755, true);
}
file_put_contents('sys/schema/init.sql', implode("\n", $out) . "\n");
echo 'Wrote sys/schema/init.sql: ' . (count($tables) + count(array_diff(FROM_VLSM, array_keys($created)))) . " tables, schema version {$version}.\n";

/**
 * SHOW CREATE TABLE, made safe for a fresh import: IF NOT EXISTS, no
 * AUTO_INCREMENT counter, and each index only once.
 */
function createStatement(PDO $pdo, string $table, ?string $schema = null): string
{
    $name = $schema === null ? "`{$table}`" : "`{$schema}`.`{$table}`";
    $sql = $pdo->query("SHOW CREATE TABLE {$name}")->fetch(PDO::FETCH_NUM)[1];
    $sql = preg_replace('/^CREATE TABLE /', 'CREATE TABLE IF NOT EXISTS ', $sql);
    $sql = preg_replace('/ AUTO_INCREMENT=\d+/', '', $sql);
    // The 0900 collations are MySQL 8 only, and MariaDB is a supported engine.
    // general_ci is what migration 3.5.0 uses for the same reason, and one
    // collation throughout keeps string joins from mixing collations.
    $sql = str_replace('utf8mb4_0900_ai_ci', 'utf8mb4_general_ci', $sql);

    // Some installs carry the same index several times over. Keep the first
    // definition for each column list, preferring the primary or unique one.
    $lines = explode("\n", $sql);
    $seen = [];
    $kept = [];
    foreach ($lines as $line) {
        if (preg_match('/^\s*(PRIMARY |UNIQUE |FULLTEXT |SPATIAL )?KEY .*?(\(.*\))/', $line, $m)) {
            $columns = ($m[1] === 'FULLTEXT ' ? 'F' : '') . $m[2];
            if (isset($seen[$columns])) {
                continue;
            }
            $seen[$columns] = true;
        }
        $kept[] = $line;
    }

    // Dropping a line can leave a trailing comma before the closing parenthesis.
    $sql = implode("\n", $kept);
    return preg_replace('/,(\s*\n\))/', '$1', $sql);
}

/** INSERT statements for $rows, one per row so a diff shows what changed. */
function insertStatements(PDO $pdo, string $table, array $rows): array
{
    if ($rows === []) {
        return [];
    }
    $columns = '`' . implode('`, `', array_keys($rows[0])) . '`';
    $out = [];
    foreach ($rows as $row) {
        $values = array_map(
            static fn($v) => $v === null ? 'NULL' : $pdo->quote((string) $v),
            array_values($row)
        );
        $out[] = "INSERT INTO `{$table}` ({$columns}) VALUES (" . implode(', ', $values) . ');';
    }
    $out[] = '';
    return $out;
}
